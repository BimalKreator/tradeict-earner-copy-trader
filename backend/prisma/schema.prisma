/// DB holds a PARTIAL unique index: UNIQUE ("key") WHERE "resolved" = false.
/// Prisma cannot express partial unique indexes, so it is intentionally not
/// declared here. Do not "fix" this by adding @@unique — see 8.6b.
model SystemAlert {
  id               String    @id @default(uuid())
  key              String
  severity         String
  source           String
  message          String
  detail           Json?
  count            Int       @default(1)
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolved         Boolean   @default(false)

  @@index([key])
  @@index([severity, acknowledgedAt])
}
