  assignedParent User @relation("UpgradeRequestAssignedParent", fields: [assignedParentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([requesterId])
  @@index([targetUserEmail])
}

/**
 * Immutable commission accrual ledger for the partner program.
 * Amounts flow: EARNED (profit booked) → PAYABLE (user paid revenue share) → WITHDRAWABLE (30d+).
 */
model CommissionLedger {
  id                  String                 @id @default(uuid())
  /** Calendar date of the source user's booked profit (UTC day). */
  profitDate          DateTime               @db.Date
  /** Trader whose revenue share generated this commission. */
  sourceUserId        String
  /** Team member receiving the commission cut. */
  beneficiaryUserId   String
  amount              Decimal                @db.Decimal(24, 10)
  /** App revenue-share $ this row was calculated from (e.g. $15 of user's due). */
  appRevenueBase      Float
  /** Rate applied at distribution (e.g. 5 = 5%). */
  commissionRate      Float
  /** Sales tier of beneficiary at accrual time. */
  beneficiaryTier     SalesTier
  status              CommissionLedgerStatus @default(EARNED)
  /** profitDate + 30 days — earliest withdrawable after PAYABLE. */
  unlockDate          DateTime
  /** Prevents double-distribution for the same profit event × beneficiary. */
  idempotencyKey      String                 @unique
  /** Set when source user pays invoice / revenue share (Phase 6). */
  invoiceId           String?
  /** Set when linked to a MonthlyRevenueInvoice (delta pipeline billing). */
  monthlyRevenueInvoiceId String?
  /** Optional link to the PnL / profit event that triggered accrual (Phase 5). */
  pnlRecordId         String?
  /** Set when payment webhook confirms revenue-share settlement (Phase 6). */
  paymentTransactionId String?
  /** Set when included in a partner payout request (Phase 9). */
  payoutRequestId     String?
  /** Batch claim token — written before PayoutRequest create (race-safe claim-first). */
  payoutClaimToken    String?
  earnedAt            DateTime               @default(now())
  payableAt           DateTime?
  withdrawableAt      DateTime?
  withdrawnAt         DateTime?
  /** True when reversing a row that was already paid out to the partner. */
  needsClawback       Boolean                @default(false)
  /** Original accrual row this reversal offsets (audit trail). */
  reversesLedgerId    String?
  isSimulated         Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  sourceUser          User                @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Restrict)
  beneficiaryUser     User                @relation("CommissionBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  invoice             Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  monthlyRevenueInvoice MonthlyRevenueInvoice? @relation(fields: [monthlyRevenueInvoiceId], references: [id], onDelete: SetNull)
  pnlRecord           PnLRecord?          @relation(fields: [pnlRecordId], references: [id], onDelete: SetNull)
  paymentTransaction  PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  payoutRequest       PayoutRequest?      @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([beneficiaryUserId, status])
  @@index([payoutRequestId])
  @@index([payoutClaimToken])
  @@index([sourceUserId, profitDate])
  @@index([status, unlockDate])
  @@index([invoiceId])
  @@index([monthlyRevenueInvoiceId])
  @@index([profitDate])
}

/** Monthly partner commission withdrawal request (Phase 9). */
model PayoutRequest {
  id               String              @id @default(uuid())
  userId           String
  amount           Decimal             @db.Decimal(24, 10)
  status           PayoutRequestStatus @default(PENDING)
  requestedAt      DateTime            @default(now())
  approvedAt       DateTime?
  approvedById     String?
  approvalReason   String?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionReason  String?
  completedAt      DateTime?
  completedById    String?
  /** UTR / bank transaction id — required when marking COMPLETED. */
  paymentReference String?
  /** Matches CommissionLedger.payoutClaimToken for this batch. */
  payoutClaimToken String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy        User?              @relation("PayoutApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy        User?              @relation("PayoutRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  completedBy       User?              @relation("PayoutCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  commissionLedgers CommissionLedger[]

  // Prisma cannot express partial unique indexes. At most one PENDING payout
  // per partner is enforced by a hand-maintained index:
  //   "PayoutRequest_userId_pending_unique" UNIQUE (userId) WHERE status = 'PENDING'
  // See scripts/addPayoutClaimTokenAndDecimalAmounts.sql. Do not drop or
  // recreate it from Prisma migrate. requestPartnerPayout maps P2002 to
  // ACTIVE_PAYOUT_EXISTS_MSG.
  @@index([userId, status])
  @@index([status, requestedAt])
  @@index([payoutClaimToken])
  @@index([approvedById])
  @@index([rejectedById])
}

