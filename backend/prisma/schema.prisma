// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  EXECUTIVE
  MANAGER
  SENIOR_MANAGER
}

/** Platform admin RBAC tier — only applies when {@link Role.ADMIN}. */
enum AdminRole {
  SUPER_ADMIN
  MANAGER
  SUPPORT
}

/** Partner commission wallet state machine (Earned → Payable → Withdrawable). */
enum CommissionLedgerStatus {
  EARNED
  PAYABLE
  WITHDRAWABLE
  /** Set when included in an approved monthly payout (Phase 9). */
  WITHDRAWN
  /** Signed reversal row — never mutate or delete the original accrual. */
  REVERSED
}

/** Which sales tier earned a commission row (snapshot at distribution time). */
enum SalesTier {
  EXECUTIVE
  MANAGER
  SENIOR_MANAGER
}

/** Member referral nomination lifecycle (Phase 1 — admin approves in Phase 2). */
enum ReferralRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Partner monthly payout request lifecycle (Phase 9). */
enum PayoutRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

/** Partner profile lifecycle — suspended when role is downgraded to USER (Phase 10). */
enum AffiliateProfileStatus {
  ACTIVE
  SUSPENDED
}

/** Sales role a partner may nominate a user for (Senior Manager / Manager requests). */
enum NominatedSalesRole {
  MANAGER
  EXECUTIVE
}

enum MemberUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED_DUE_TO_FUNDS
  /** User voluntarily paused — billing continues for closed structures. */
  PAUSED_BY_USER
  CANCELLED
}

enum TradeStatus {
  OPEN
  CLOSED
  FAILED
}

/** Exchange leg ledger — ties each open/close to a strategy (and user or master). */
enum TradePositionStatus {
  OPEN
  CLOSED
}

enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TransactionType {
  PAYMENT
  FEE
  WITHDRAWAL_REQUEST
  ADMIN_ADJUSTMENT
}

enum WalletWithdrawalStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ProfileUpdateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

/** Revenue-share (PnL) vs monthly strategy subscription fee. */
enum InvoiceKind {
  REVENUE_SHARE
  STRATEGY_FEE
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum FutureHedgeBatchTrend {
  UPTREND
  DOWNTREND
}

model User {
  id            String              @id @default(uuid())
  email         String              @unique
  password      String
  name          String?
  mobile        String?
  /** Date of birth (KYC). */
  dob           DateTime?
  /** Father's or husband's name (KYC). */
  guardianName  String?
  gender        String?
  address       String?
  city          String?
  state         String?
  pinCode       String?
  aadharNumber  String?             @unique
  panNumber     String?             @unique
  bankName      String?
  bankAccountNumber String?
  bankIfsc      String?
  upiId         String?
  nomineeName   String?
  nomineeRelationship String?
  nomineeMobile String?
  role          Role                @default(USER)
  /** RBAC tier for platform admins (`role === ADMIN`). */
  adminRole     AdminRole?
  /** Immediate upline in the sales hierarchy (Executive→Manager, Manager→Senior Manager). */
  parentId      String?
  /** Team member who referred/acquired this user (set at signup — Phase 4). */
  acquiredById  String?
  status             UserStatus          @default(ACTIVE)
  /** When true, copy engine skips this user even if subscriptions are ACTIVE. */
  copyTradingPaused  Boolean             @default(false)
  /** Crypto arbitrage bot enabled for this user. */
  cryptoArbitrageEnabled       Boolean @default(false)
  /** Simulated / platform crypto arbitrage balance (USDT). */
  cryptoBalance                Float   @default(0.0)
  /** Percent of cryptoBalance allocated per arbitrage trade. */
  cryptoCapitalPerTradePercent Float   @default(10.0)
  /** When set, this user's arbitrage trades UI reads from the source user's trade history. */
  arbitrageSourceUserId        String?
  /**
   * USDT amount added to Delta balance shown on the user dashboard only.
   * Never applied to margin checks, copy-trading, or exchange execution.
   */
  deltaBalanceDisplayOffset    Float   @default(0)
  /** Google Play / store review accounts — skip login OTP (password-only). */
  isOtpBypassed                Boolean @default(false)
  /** Admin-granted permission to run Delta revenue pipeline simulations. */
  allowSimulation              Boolean @default(false)
  /**
   * Incremented on logout and password reset. JWTs embed this value;
   * authMiddleware rejects a mismatch (401).
   */
  tokenVersion                 Int      @default(0)
  /** bcrypt hash of the login OTP (never store the six-digit code in the clear). */
  loginOtpHash                 String?
  loginOtpExpiry               DateTime?
  loginOtpAttempts             Int      @default(0)
  /** bcrypt hash of the password-reset OTP — distinct from login OTP. */
  resetOtpHash                 String?
  resetOtpExpiry               DateTime?
  resetOtpAttempts             Int      @default(0)
  telegramChatId       String?              @unique
  telegramLinkToken    String?              @unique
  telegramLinkExpires  DateTime?
  createdAt     DateTime            @default(now())
  /** High-water mark for Delta wallet transaction ledger ingestion (UTC). */
  deltaLedgerSyncedUpTo DateTime?
  /** Set when a deep sweep inserts rows into an already-invoiced period — manual recompute needed. */
  deltaLedgerRecomputeRequired Boolean @default(false)
  /** Cancellation: final ACCRUED invoice deferred until Delta ledger settles. */
  pendingFinalInvoiceSince DateTime?
  pendingFinalInvoicePeriodYear Int?
  pendingFinalInvoicePeriodMonth Int?
  /** Admin-visible alerts when late data would change a frozen invoice period. */
  revenueFrozenPeriodAlerts Json?

  deltaApiKeys     DeltaApiKey[]
  exchangeAccounts ExchangeAccount[]
  subscriptions    UserStrategySubscription[]
  trades           Trade[]
  tradePositions   TradePosition[]
  wallet        Wallet?
  transactions  Transaction[]
  walletWithdrawalRequests WalletWithdrawalRequest[]
  invoices      Invoice[]
  pnlRecords    PnLRecord[]
  deltaLedgerEntries DeltaLedgerEntry[]
  structurePnls      StructurePnl[]
  dailyPnlSnapshots  DailyPnlSnapshot[]
  monthlyRevenueInvoices MonthlyRevenueInvoice[]
  activities    UserActivity[]
  profileUpdateRequests ProfileUpdateRequest[]
  depositRequests      DepositRequest[]
  paymentTransactions  PaymentTransaction[]
  notifications        Notification[]
  arbitrageTrades      ArbitrageTrade[]
  arbitrageWithdrawals ArbitrageWithdrawal[]
  arbitrageSourceUser  User?                 @relation("ArbitrageSource", fields: [arbitrageSourceUserId], references: [id], onDelete: SetNull)
  arbitrageSourceFollowers User[]            @relation("ArbitrageSource")
  tickets              Ticket[]
  ticketMessages       TicketMessage[]
  parent               User?               @relation("SalesHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  directReports        User[]              @relation("SalesHierarchy")
  acquiredBy           User?               @relation("UserAcquisition", fields: [acquiredById], references: [id], onDelete: SetNull)
  acquiredUsers        User[]              @relation("UserAcquisition")
  affiliateProfile     AffiliateProfile?
  commissionsEarned    CommissionLedger[]  @relation("CommissionBeneficiary")
  commissionsSourced   CommissionLedger[]  @relation("CommissionSource")
  affiliateUpgradesPerformed AffiliateProfile[] @relation("AffiliateUpgradedBy")
  payoutRequests       PayoutRequest[]
  partnerPayoutsCompleted PayoutRequest[]    @relation("PayoutCompletedBy")
  partnerPayoutsApproved  PayoutRequest[]    @relation("PayoutApprovedBy")
  partnerPayoutsRejected  PayoutRequest[]    @relation("PayoutRejectedBy")
  upgradeRequestsSubmitted MemberUpgradeRequest[] @relation("UpgradeRequestRequester")
  upgradeRequestsAsParent  MemberUpgradeRequest[] @relation("UpgradeRequestAssignedParent")
  referralRequestsSubmitted ReferralRequest[]     @relation("ReferralRequestSponsor")
  adminAuditLogs            AdminAuditLog[]

  @@index([parentId])
  @@index([acquiredById])
  @@index([role])
}

model OtpRecord {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Strategy {
  id                 String  @id @default(uuid())
  title              String
  description        String
  /** Delta Exchange (India) API key for the leader account whose positions are copied. */
  masterApiKey       String  @default("")
  masterApiSecret    String  @default("")
  performanceMetrics Json?
  slippage           Float   @default(0.5)
  monthlyFee         Float
  profitShare        Float   @default(20.0)
  minCapital         Float
  /** Admin reference capital (USD) used to derive copy multiplier: deployedCapital / baseCapital. */
  baseCapital        Float   @default(10)
  /** When false, copy-trading and hedge automation skip this strategy. */
  isActive             Boolean @default(true)
  /** When true, new subscribers mirror the strategy's currently open master (leader) positions on Delta (late-join). */
  syncActiveTrades   Boolean @default(false)
  /** When set, this strategy delegates copy trading to an external Delta bot at this URL. */
  botUrl             String?
  /** Identifies which bot type powers this strategy: 'short_strangle' | null */
  botStrategyType    String?
  /** Total master unrealized PnL (USD) at or above this value triggers auto-exit (close all master legs). */
  autoExitTarget     Float?
  /** Total master unrealized PnL (USD) at or below negative this value triggers auto-exit (e.g. 5 → exit at -$5). */
  autoExitStopLoss   Float?
  /** When true, target/stop-loss thresholds may trigger automatic master flat + follower copy. */
  autoExitEnabled    Boolean @default(false)
  createdAt          DateTime @default(now())

  subscriptions      UserStrategySubscription[]
  trades             Trade[]
  tradePositions     TradePosition[]
  pnlRecords         PnLRecord[]
  invoices           Invoice[]
  futureHedgeConfig  FutureHedgeConfig?
}

/** Automation settings for the "Future Hedge Strategy" leader bot. */
model FutureHedgeConfig {
  id              String   @id @default(uuid())
  strategyId      String   @unique
  isAutoEnabled   Boolean  @default(false)
  baseLots        Int      @default(1)
  emaPeriod       Int      @default(200)
  adjustmentPct   Float    @default(0.5)
  targetProfitUsd Float    @default(10.0)
  /** When true, auto-flat master legs when BTC price breaches breakeven bounds. */
  isBreakevenExitEnabled Boolean @default(false)
  /** Lower/upper breakeven bound (USD); either or both may be set. */
  breakevenPrice1        Float?
  breakevenPrice2        Float?
  /** Groups a run of hedge adjustments; cleared when a batch completes. */
  currentBatchId  String?
  /** BTC perp price anchor for the adjustment grid (updated each entry/adjustment). */
  lastEntryPrice        Float?
  /** Direction locked when the batch opens. */
  batchTrend            FutureHedgeBatchTrend?
  /** Option product id (same expiry for all adjustments in the batch). */
  batchOptionProductId  String?
  batchOptionExpiryMs   BigInt?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  strategy    Strategy                 @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  executions  FutureHedgeExecution[]
}

model FutureHedgeExecution {
  id        String   @id @default(uuid())
  batchId   String
  configId  String
  kind      String
  leg       String
  side      String
  symbol    String
  lots      Int
  price     Float?
  orderId   String?
  createdAt DateTime @default(now())

  config FutureHedgeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([configId, batchId])
}

/// Per-user subscription to a single copy-trading strategy (table: `UserSubscription`).
model UserStrategySubscription {
  id                 String              @id @default(uuid())
  userId             String
  strategyId         String
  exchangeAccountId  String?
  /** Scales master contract size for this user on this strategy only. */
  multiplier         Float               @default(1.0)
  /** When true, copy engine may open/adjust trades for this user on this strategy. */
  isActive           Boolean             @default(true)
  status             SubscriptionStatus  @default(ACTIVE)
  /** Follower copy state vs master: SYNCED, ERROR, etc. */
  syncStatus         String              @default("SYNCED")
  /** Last copy failure reason (e.g. Insufficient Funds). */
  syncError          String?
  /** False when user chose pay-later for the monthly strategy fee. */
  isStrategyFeePaid  Boolean             @default(false)
  /** Pay-later grace window end (UTC); copy pauses when unpaid after this. */
  strategyFeeCycleEndsAt DateTime?
  /** Bot slave account ID on the Delta Bot — set when user subscribes to a bot-type strategy. */
  botSlaveId         String?
  /** Admin override for revenue share % on this subscription (null = use strategy default). */
  profitShareOverride Decimal? @db.Decimal(6, 3)
  /** profitShare % locked at subscribe time — used for billing when subscription is paused. */
  profitSharePctSnapshot Decimal? @db.Decimal(6, 3)
  joinedDate         DateTime            @default(now())

  user             User             @relation(fields: [userId], references: [id])
  strategy         Strategy         @relation(fields: [strategyId], references: [id])
  exchangeAccount  ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, strategyId])
  @@map("UserSubscription")
}

model ExchangeAccount {
  id        String   @id @default(uuid())
  userId    String
  nickname  String
  exchange  String   @default("Delta")
  apiKey    String
  apiSecret String
  createdAt DateTime @default(now())
  /** High-water mark for this account's Delta wallet ledger ingestion (UTC). */
  deltaLedgerSyncedUpTo DateTime?

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions  UserStrategySubscription[]
  deltaLedgerEntries DeltaLedgerEntry[]

  @@index([userId])
}

/** Immutable copy of Delta wallet transactions — source of truth for customer P&L. */
model DeltaLedgerEntry {
  id              String   @id @default(cuid())
  userId          String
  /** Which ExchangeAccount produced this row; null on legacy rows ingested before multi-account sync. */
  exchangeAccountId String?
  deltaUuid       String
  productId       Int?
  productSymbol   String?
  transactionType String
  amount          Decimal  @db.Decimal(24, 10)
  balanceAfter    Decimal? @db.Decimal(24, 10)
  metaJson        Json?
  occurredAt      DateTime
  ingestedAt      DateTime @default(now())
  /** Incoming amount when Delta corrected a row we already stored (stored amount unchanged). */
  conflictAmount  Decimal? @db.Decimal(24, 10)
  conflictSeenAt  DateTime?
  isSimulated     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  exchangeAccount ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id], onDelete: SetNull)

  // Delta wallet txn ids are exchange-wide ledger keys — unique per Tradeict user without account.
  @@unique([userId, deltaUuid])
  @@index([userId, productId, occurredAt])
  @@index([exchangeAccountId])
  @@index([isSimulated])
}

/** Realized P&L for one bot structure, computed from the user's Delta ledger. */
model StructurePnl {
  id                 String   @id @default(cuid())
  userId             String
  botStructureId     Int
  hedgePositionId    Int
  underlying         String
  status             String
  openedAt           DateTime
  closedAt           DateTime?
  closeReason        String?
  grossCashflow      Decimal  @db.Decimal(24, 10)
  commissionTotal    Decimal  @db.Decimal(24, 10)
  realizedPnl        Decimal? @db.Decimal(24, 10)
  legCount           Int
  closedLegCount     Int
  matchedTxnCount    Int
  computedAt         DateTime
  /** OK = complete entry+exit attribution; SUSPECT_INCOMPLETE = billing blocked. */
  attributionStatus  String?
  attributionNote    String?
  /**
   * Absolute amount of ledger rows refused / unattributable for this structure
   * (e.g. overlap). Used to bound worst-case P&L for RULE 9 HWM asymmetry.
   */
  attributionDroppedAmount Decimal? @db.Decimal(24, 10)
  isSimulated        Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  legs StructureLegPnl[]

  @@unique([userId, botStructureId])
  @@index([isSimulated])
  @@index([attributionStatus])
}

/** Per-leg P&L attribution within a structure (product_id + time window). */
model StructureLegPnl {
  id               String   @id @default(cuid())
  structurePnlId   String
  botLegId         Int
  legRole          String
  basketSeq        Int?
  adjSeq           Int?
  productId        Int
  symbol           String?
  strike           Float?
  side             String
  quantity         Int
  openedAt         DateTime
  /** Ledger window start override; null = use openedAt. */
  attributionFrom  DateTime?
  closedAt         DateTime?
  grossCashflow    Decimal  @db.Decimal(24, 10)
  commissionTotal  Decimal  @db.Decimal(24, 10)
  /** Perp futures funding attributed to this leg (customer cost). */
  fundingTotal     Decimal? @db.Decimal(24, 10)
  /** ITM option expiry settlement attributed to this leg. */
  settlementTotal  Decimal? @db.Decimal(24, 10)
  /** Liquidation fee attributed to this leg. */
  liquidationFeeTotal Decimal? @db.Decimal(24, 10)
  realizedPnl      Decimal? @db.Decimal(24, 10)
  matchedTxnCount  Int
  isSimulated      Boolean  @default(false)

  structure StructurePnl @relation(fields: [structurePnlId], references: [id], onDelete: Cascade)

  @@unique([structurePnlId, botLegId])
}

/** Daily cumulative realized P&L snapshot (IST calendar day, closed structures only). */
model DailyPnlSnapshot {
  id                   String   @id @default(cuid())
  userId               String
  snapshotDate         DateTime
  realizedDelta        Decimal  @db.Decimal(24, 10)
  cumulativeRealized   Decimal  @db.Decimal(24, 10)
  highWaterMark        Decimal  @db.Decimal(24, 10)
  commissionAccrued    Decimal  @db.Decimal(24, 10)
  commissionCumulative Decimal  @db.Decimal(24, 10)
  openStructureCount   Int
  computedAt           DateTime
  isSimulated          Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Real and simulated snapshots are independent chains — never share a slot.
  @@unique([userId, snapshotDate, isSimulated])
  @@index([isSimulated])
}

/** Monthly revenue invoice accrued from structure P&L (IST calendar month). */
model MonthlyRevenueInvoice {
  id               String   @id @default(cuid())
  userId           String
  periodYear       Int
  periodMonth      Int
  structuresClosed Int
  /** Closed structures excluded from billing due to incomplete leg attribution. */
  suspectStructuresCount Int?
  /** Suspect losses included in cumulative/HWM (not billed). */
  suspectLossesCountedCount Int?
  /** Sum of suspect-loss realizedPnl counted into cumulative/HWM. */
  suspectLossesCountedAmount Decimal? @db.Decimal(24, 10)
  /** Billing ledger rows that matched more than one leg window in this period. */
  overlapTxnCount Int?
  realizedPnl      Decimal  @db.Decimal(24, 10)
  /** Lifetime cumulative realized P&L at period end — audit trail for HWM. */
  cumulativeRealizedPnl Decimal? @db.Decimal(24, 10)
  hwmBefore        Decimal  @db.Decimal(24, 10)
  hwmAfter         Decimal  @db.Decimal(24, 10)
  billableProfit   Decimal  @db.Decimal(24, 10)
  profitSharePct   Decimal  @db.Decimal(6, 3)
  commissionAmount Decimal  @db.Decimal(24, 10)
  status           String
  /** When ACCRUED → INVOICED (IST month-end billing). */
  invoicedAt       DateTime?
  dueDate          DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  voidReason       String?
  /** INR amount pinned at invoicing (commissionAmount × usdInrRate). */
  amountInr        Decimal? @db.Decimal(24, 10)
  /** USD/INR rate pinned at invoicing. */
  usdInrRate       Decimal? @db.Decimal(24, 10)
  paymentReference String?
  /** Admin credit note — reduces collectible amount without changing commissionAmount. */
  creditNoteAmount Decimal? @db.Decimal(24, 10)
  creditNoteReason String?
  isFinal          Boolean  @default(false)
  isSimulated      Boolean  @default(false)
  generatedAt      DateTime

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  commissionLedgers  CommissionLedger[]

  // Real and simulated invoices for the same period are independent rows.
  @@unique([userId, periodYear, periodMonth, isSimulated])
  @@index([isSimulated])
}

model Trade {
  id              String      @id @default(uuid())
  userId          String
  strategyId      String
  symbol          String
  side            String
  size            Float
  entryPrice      Float
  exitPrice       Float?
  pnl             Float?
  tradePnl        Float       @default(0)
  tradingFee      Float       @default(0)
  revenueShareAmt Float       @default(0)
  status          TradeStatus @default(OPEN)
  /** Why the trade was closed or marked failed (set by trade engine / admin). */
  exitReason      String?
  /** Stable id for copy dedup (master fill × follower leg). */
  clientOrderId   String?     @unique
  /** Admin-injected test trade — no exchange execution. */
  isDummy         Boolean     @default(false)
  /** Origin tag — `BOT_SYNC_LEGACY` for retired bot MTM poller rows. */
  source          String?
  /** When status became CLOSED — billing windows on this, not createdAt. */
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  strategy   Strategy    @relation(fields: [strategyId], references: [id])

  @@index([status, closedAt])
}

/// Per-order leg registry so copy trades never mix across strategies.
model TradePosition {
  id            String              @id @default(uuid())
  /** Null when `isMaster` is true (strategy leader account). */
  userId        String?
  isMaster      Boolean             @default(false)
  strategyId    String
  symbol        String
  side          String
  quantity      Float
  entryPrice    Float
  clientOrderId String              @unique
  status        TradePositionStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId, status])
  @@index([userId, strategyId, status])
  @@index([isMaster, strategyId, status, symbol, side])
}

model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  balance       Float         @default(0.0)
  lockedBalance Float         @default(0.0)
  pendingFees   Float         @default(0.0)
  overdueDays   Int           @default(0)

  user                User                      @relation(fields: [userId], references: [id])
  transactions        WalletTransaction[]
  withdrawalRequests  WalletWithdrawalRequest[]
}

model WalletWithdrawalRequest {
  id                  String                 @id @default(uuid())
  walletId            String
  userId              String
  amount              Float
  status              WalletWithdrawalStatus @default(PENDING)
  bankName            String?
  bankAccountNumber   String?
  bankIfsc            String?
  /** Bank transfer reference filled by admin on completion. */
  transactionId       String?
  adminRemarks        String?
  ledgerTransactionId String?                @unique
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  wallet            Wallet       @relation(fields: [walletId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
  ledgerTransaction Transaction? @relation(fields: [ledgerTransactionId], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
}

model WalletTransaction {
  id        String   @id @default(uuid())
  walletId  String
  amount    Float
  type      String
  status    String
  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  amount    Float
  type      TransactionType   @default(PAYMENT)
  utrNumber String?           @unique
  note      String?
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())

  user                    User                     @relation(fields: [userId], references: [id])
  walletWithdrawalRequest WalletWithdrawalRequest?
}

model ProfileUpdateRequest {
  id            String              @id @default(uuid())
  userId        String
  address       String?
  panNumber     String?
  aadharNumber  String?
  status        ProfileUpdateStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model SystemSettings {
  id                  String   @id @default("global")
  pgFeePercent        Float    @default(2.36)
  allowedEmailDomains String   @default("gmail.com,yahoo.com,hotmail.com,outlook.com")
  /** USD → INR rate for Razorpay and wallet INR display. Null until an admin sets it. */
  usdInrRate          Float?
  /** When an admin last set usdInrRate — used for staleness checks. */
  usdInrRateUpdatedAt DateTime?
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?
  /** Max total partner commission % of app revenue per profit event (scale-down cap). */
  partnerMaxCommissionPct       Float @default(8)
  /** Executive directly acquired the trader (USER) — % of app revenue. */
  partnerExecutiveDirectPct     Float @default(5)
  /** Manager upline when Executive acquired the trader. */
  partnerManagerUnderExecPct    Float @default(2)
  /** Director upline when Executive acquired the trader (and Manager exists). */
  partnerDirectorUnderExecPct   Float @default(1)
  /** Manager is chain entry (acquired trader or Manager's own trade upline). */
  partnerManagerDirectPct       Float @default(6)
  /** Director upline when Manager is chain entry. */
  partnerDirectorUnderMgrPct    Float @default(2)
  /** Director is chain entry (acquired trader). */
  partnerDirectorDirectPct      Float @default(8)
  updatedAt           DateTime @updatedAt
}

