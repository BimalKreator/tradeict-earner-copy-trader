# Required — shared secret for HMAC verification of POST /api/internal/* webhooks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bot must send header x-internal-signature = HMAC-SHA256(raw JSON body, this secret) as lowercase hex.
BOT_WEBHOOK_SECRET=

# Comma-separated browser origins allowed for CORS (required in production).
# Example: https://tradeictearner.online,https://www.tradeictearner.online
ALLOWED_ORIGINS=https://tradeictearner.online

# Optional — comma-separated IPs allowed to call /api/internal (e.g. 127.0.0.1,10.0.0.5).
# When unset, only the HMAC signature is checked.
INTERNAL_IP_ALLOWLIST=

# When true, POST /api/internal/bot-trade-closed may create PnLRecord rows via recordTradePnl.
# Default (unset or not "true"): Trade audit rows are still written, but P&L records are skipped.
INTERNAL_WEBHOOK_PNL_WRITES_ENABLED=false

# Crypto arbitrage engine cron — off by default (UI removed; set to 1 to re-enable scheduling).
ARBITRAGE_ENGINE_ENABLED=0

# Max age (hours) of an admin-set USD/INR rate before billing refuses to use it.
USD_INR_RATE_MAX_AGE_HOURS=48
